# Backend only: public URL for invitation/password-reset and Discord links.
# This does not restrict which browser origin an enrolled gateway can serve.
TASKBOARD_BASE_URL=http://localhost:8080
# Backend cookie policy: use true when browsers access the gateway over HTTPS.
TASKBOARD_SECURE_COOKIES=false

# Gateway only: exact browser origin (scheme, hostname, port), independent of the
# backend link URL. Use http://127.0.0.1:8080 if that is how you open the app.
# Behind a TLS proxy, use the public https:// origin, not the internal listener.
TASKBOARD_GATEWAY_ORIGIN=http://localhost:8080

# Seeds the persistent content threshold on FIRST database initialization.
# Later changes are made in Administration. 0 means unlimited.
# Example: 1 = 1 GiB. All uploaded images count toward this threshold.
TASKBOARD_MAX_DB_GIB=0

# Maximum size of one uploaded image, in whole MiB. Enforced by the backend.
TASKBOARD_MAX_IMAGE_MIB=10

# Optional bot configuration. Do not commit your real bot token.
TASKBOARD_DISCORD_TOKEN=
TASKBOARD_DISCORD_GUILD_ID=

# Compose uses host networking. The gateway binds localhost:8080 by default.
# Set 0.0.0.0 for LAN access if desired; there is no Docker port mapping.
TASKBOARD_PUBLISH_ADDRESS=127.0.0.1

# One-use enrollment credential generated by the backend. This is consumed by one
# persistent gateway identity; keep the gateway data volume across restarts.
TASKBOARD_RTN_JOIN_CODE=

# Both services: prefer direct Iroh connections; retain relays for fallback.
# Set true only when intentionally forcing all traffic through a relay.
TASKBOARD_RTN_RELAY_ONLY=false

# Normally keep the container's defaults for these:
# just exports your current host UID/GID automatically. For direct Compose use:
# export TASKBOARD_UID="$(id -u)" TASKBOARD_GID="$(id -g)"
# Do not copy numeric IDs between hosts; run the command on each machine.
# TASKBOARD_DATABASE=/data/taskboard.db
# TASKBOARD_FRONTEND=/www
# Compose derives TASKBOARD_GATEWAY_BIND from TASKBOARD_PUBLISH_ADDRESS above.
# When running the gateway image directly: TASKBOARD_GATEWAY_BIND=0.0.0.0:8080
# Gateway only; the backend identity and enrollment state are in Turso.
# TASKBOARD_RTN_IDENTITY=/data/rtn/gateway.key
RUST_LOG=taskboard=info,taskboard_gateway=info,tower_http=info,rtn_mq=info,iroh=warn,iroh_relay=warn
