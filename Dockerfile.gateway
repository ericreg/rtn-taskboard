# syntax=docker/dockerfile:1.7
FROM node:24-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM rust:1.96-alpine AS builder
RUN apk add --no-cache musl-dev build-base binutils ca-certificates
WORKDIR /build
COPY --from=rtn_mq . /build/rtn-mq
WORKDIR /build/rtn-taskboard
COPY Cargo.toml Cargo.lock ./
COPY backend/ ./backend/
COPY gateway/ ./gateway/
COPY wire/ ./wire/
RUN --mount=type=cache,id=taskboard-cargo-registry,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,id=taskboard-cargo-target,sharing=locked,target=/build/rtn-taskboard/target \
    cargo build --release --locked -p taskboard-gateway && \
    mkdir -p /out /runtime/data/rtn /runtime/tmp && \
    cp target/release/taskboard-gateway /out/taskboard-gateway && \
    if readelf -l /out/taskboard-gateway | grep -q INTERP; then echo 'Binary must be statically linked'; exit 1; fi
ARG TASKBOARD_UID=10001
ARG TASKBOARD_GID=10001
RUN chown -R ${TASKBOARD_UID}:${TASKBOARD_GID} /runtime/data /runtime/tmp && \
    chmod 0700 /runtime/data/rtn && chmod 1777 /runtime/tmp

FROM scratch AS runtime
ARG TASKBOARD_UID=10001
ARG TASKBOARD_GID=10001
COPY --from=builder /out/taskboard-gateway /taskboard-gateway
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder --chown=${TASKBOARD_UID}:${TASKBOARD_GID} /runtime/data /data
COPY --from=builder --chown=${TASKBOARD_UID}:${TASKBOARD_GID} /runtime/tmp /tmp
COPY --from=frontend /build/frontend/dist /www
USER ${TASKBOARD_UID}:${TASKBOARD_GID}
ENV TASKBOARD_FRONTEND=/www \
    TASKBOARD_GATEWAY_BIND=0.0.0.0:8080 \
    TASKBOARD_RTN_IDENTITY=/data/rtn/gateway.key \
    TASKBOARD_RTN_RELAY_ONLY=true
EXPOSE 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["/taskboard-gateway", "healthcheck"]
ENTRYPOINT ["/taskboard-gateway"]
