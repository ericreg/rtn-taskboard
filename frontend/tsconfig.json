{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.d.ts", "vite.config.ts"]
}
